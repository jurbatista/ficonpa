# Banco e filas (somente leitura na tela de Configurações)
DATABASE_URL=postgres://ficonpa:ficonpa@localhost:5432/ficonpa
REDIS_URL=redis://localhost:6379

# Aplicação (somente leitura na tela de Configurações)
APP_URL=http://localhost:3000
AUTH_SECRET=troque-por-uma-string-aleatoria-bem-longa
APP_ENCRYPTION_KEY=troque-por-32-bytes-em-base64

# Senha de acesso (fallback; pode ser alterada em Configurações → Senha de acesso)
APP_PASSWORD=ficonpa
# Opcional: hash scrypt gerado pela aplicação. Se definido, tem prioridade sobre APP_PASSWORD.
# APP_PASSWORD_HASH=

# Conta Azul (também editável em Configurações → Conta Azul)
CONTA_AZUL_CLIENT_ID=
CONTA_AZUL_CLIENT_SECRET=
CONTA_AZUL_REDIRECT_URI=http://localhost:3000/api/conta-azul/callback

# OpenRouter (também editável em Configurações → OpenRouter / Modelos de IA)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-vl-235b-a22b-instruct
JEV_MODEL=typesafe/jev-1.14

# Armazenamento de anexos (somente leitura na tela de Configurações)
# No Docker use /app/data/attachments
ATTACHMENT_DIR=./data/attachments
